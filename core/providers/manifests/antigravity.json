{
  "schemaVersion": 1,
  "id": "antigravity",
  "name": "Antigravity",
  "product": "Antigravity subscription",
  "releaseStatus": "experimental",
  "adapterVersion": "0.1.0",
  "platforms": [
    "darwin"
  ],
  "docsPath": "docs/providers/antigravity.md",
  "documentationUrls": [
    "https://github.com/subsbar/subsbar#readme"
  ],
  "credentialReaders": [
    {
      "id": "agy-official-usage",
      "kind": "cli",
      "credentialKinds": [
        "cli-session"
      ],
      "implementationId": "agy-official-usage",
      "configurable": [
        "executablePath"
      ],
      "requires": [],
      "purposes": [
        "primary"
      ],
      "owner": "external",
      "renewMode": "owner-cli"
    },
    {
      "id": "antigravity-local-api",
      "kind": "local-api",
      "credentialKinds": [
        "oauth"
      ],
      "implementationId": "localapi-generic",
      "configurable": [],
      "requires": [
        "local-api"
      ],
      "purposes": [
        "primary"
      ],
      "owner": "external",
      "renewMode": "none"
    }
  ],
  "endpoints": [
    {
      "id": "agy-usage",
      "transport": "cli",
      "operation": "usage",
      "readOnly": true,
      "grade": "C",
      "maxResponseBytes": 65536,
      "authPurpose": "primary",
      "documentationUrl": "https://github.com/subsbar/subsbar#readme",
      "commandId": "agy-usage"
    },
    {
      "id": "antigravity-server",
      "transport": "loopback",
      "operation": "usage",
      "readOnly": true,
      "grade": "C",
      "maxResponseBytes": 65536,
      "authPurpose": "primary",
      "documentationUrl": "https://github.com/subsbar/subsbar#readme",
      "helperId": "antigravity-language-server"
    }
  ],
  "dataSources": [
    {
      "id": "antigravity-cli",
      "kind": "official-cli",
      "grade": "A",
      "admission": "pending",
      "approvalNote": "pending-verification: 防御性解析已实现，响应字段名未经真实账号验证（本机网络无法核实开源实现细节）；真实账号冒烟前排程",
      "endpointIds": [
        "agy-usage"
      ],
      "credentialChain": [
        "agy-official-usage"
      ],
      "capabilities": [
        "quota"
      ],
      "coverageMetricRules": [
        "antigravity-gemini"
      ],
      "coverageMatch": "any"
    }
  ],
  "refresh": {
    "minimumIntervalSeconds": 60,
    "defaultIntervalSeconds": 300,
    "taskTimeoutSeconds": 30,
    "requestTimeoutSeconds": 15
  },
  "metricRules": [
    {
      "id": "antigravity-gemini",
      "metricId": "gemini",
      "kind": "quota",
      "unit": "percent",
      "scope": "subscription",
      "period": "rolling",
      "derivations": [],
      "description": "Gemini / non-Gemini pools as returned",
      "missingPolicy": "unknown"
    }
  ],
  "primaryPreference": [
    "antigravity-gemini"
  ],
  "diagnosticCodes": [
    "pending-verification"
  ],
  "reasonCodes": [],
  "fixtureIds": [
    "antigravity-synthetic-normal",
    "antigravity-synthetic-missing"
  ],
  "provenance": [],
  "login": {
    "mode": "guide",
    "note": "启动 Antigravity app 或运行 agy 交互登录（--help 核实无非交互 login 子命令，UNVERIFIED）",
    "verified": false
  }
}
