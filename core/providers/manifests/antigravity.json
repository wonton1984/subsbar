{
  "schemaVersion": 1,
  "id": "antigravity",
  "name": "Antigravity",
  "product": "Antigravity subscription",
  "releaseStatus": "supported",
  "adapterVersion": "0.1.0",
  "platforms": [
    "darwin"
  ],
  "docsPath": "docs/providers/antigravity.md",
  "documentationUrls": [
    "https://antigravity.google/docs/changelog",
    "https://antigravity.google"
  ],
  "credentialReaders": [
    {
      "id": "agy-official-usage",
      "kind": "cli",
      "credentialKinds": [
        "cli-session"
      ],
      "implementationId": "agy-official-usage",
      "configurable": [
        "executablePath"
      ],
      "requires": [],
      "purposes": [
        "primary"
      ],
      "owner": "external",
      "renewMode": "owner-cli"
    },
    {
      "id": "antigravity-local-api",
      "kind": "local-api",
      "credentialKinds": [
        "oauth"
      ],
      "implementationId": "localapi-generic",
      "configurable": [],
      "requires": [
        "local-api"
      ],
      "purposes": [
        "primary"
      ],
      "owner": "external",
      "renewMode": "none"
    },
    {
      "id": "antigravity-subsbar-oauth",
      "kind": "keychain",
      "credentialKinds": [
        "oauth"
      ],
      "implementationId": "antigravity-subsbar-key",
      "configurable": [
        "service",
        "account",
        "keychainPath"
      ],
      "requires": [
        "keychain"
      ],
      "purposes": [
        "primary"
      ],
      "owner": "subsbar",
      "renewMode": "none",
      "credentialService": "SubsBar credential <providerId>"
    }
  ],
  "endpoints": [
    {
      "id": "agy-usage",
      "transport": "cli",
      "operation": "usage",
      "readOnly": true,
      "grade": "A",
      "maxResponseBytes": 65536,
      "authPurpose": "primary",
      "documentationUrl": "https://antigravity.google/docs/changelog",
      "commandId": "agy-usage"
    },
    {
      "id": "antigravity-server",
      "transport": "loopback",
      "operation": "usage",
      "readOnly": true,
      "grade": "C",
      "maxResponseBytes": 65536,
      "authPurpose": "primary",
      "documentationUrl": "https://antigravity.google/docs/changelog",
      "helperId": "antigravity-language-server"
    }
  ],
  "dataSources": [
    {
      "id": "antigravity-cli",
      "kind": "official-cli",
      "grade": "A",
      "admission": "approved",
      "approvalNote": "2026-10-03 真实验证：agy 1.2.16 `agy -p /usage --output-format json`。官方形状为 command.data.groups[].buckets[]（remaining_fraction + reset_time UTC）。覆盖 Gemini Models（Flash/Pro 共享）与 Claude and GPT models（Opus/Sonnet/GPT-OSS）的 5h/weekly。未见 credits/balance。不刮 TSV response、不把本次 usage tokens 当订阅窗。local-api 仍 not-implemented。",
      "endpointIds": [
        "agy-usage"
      ],
      "credentialChain": [
        "agy-official-usage"
      ],
      "capabilities": [
        "quota"
      ],
      "coverageMetricRules": [
        "antigravity-gemini",
        "antigravity-gemini-weekly",
        "antigravity-other",
        "antigravity-other-weekly"
      ],
      "coverageMatch": "any"
    },
    {
      "id": "antigravity-local-api",
      "kind": "local-api",
      "grade": "C",
      "admission": "pending",
      "approvalNote": "docs/providers/antigravity.md；local-api 仅 loopback、须 profile.allowLocalApi。CSRF/同账户进程本轮未验证，resolve=not-implemented。不在默认自动链。",
      "endpointIds": [
        "antigravity-server"
      ],
      "credentialChain": [
        "antigravity-local-api"
      ],
      "capabilities": [
        "quota"
      ],
      "coverageMetricRules": [
        "antigravity-gemini"
      ],
      "coverageMatch": "any"
    }
  ],
  "refresh": {
    "minimumIntervalSeconds": 60,
    "defaultIntervalSeconds": 300,
    "taskTimeoutSeconds": 30,
    "requestTimeoutSeconds": 15
  },
  "metricRules": [
    {
      "id": "antigravity-gemini",
      "metricId": "antigravity-gemini",
      "kind": "quota",
      "unit": "percent",
      "scope": "subscription",
      "period": "rolling",
      "derivations": [],
      "description": "shared Gemini pool percent used as returned",
      "missingPolicy": "unknown"
    },
    {
      "id": "antigravity-other",
      "metricId": "antigravity-other",
      "kind": "quota",
      "unit": "percent",
      "scope": "subscription",
      "period": "rolling",
      "derivations": [],
      "description": "non-Gemini 5h remaining_fraction as used percent",
      "missingPolicy": "omit-optional"
    },
    {
      "id": "antigravity-gemini-weekly",
      "metricId": "antigravity-gemini-weekly",
      "kind": "quota",
      "unit": "percent",
      "scope": "subscription",
      "period": "rolling",
      "derivations": [],
      "description": "Gemini weekly remaining_fraction as used percent",
      "missingPolicy": "omit-optional"
    },
    {
      "id": "antigravity-other-weekly",
      "metricId": "antigravity-other-weekly",
      "kind": "quota",
      "unit": "percent",
      "scope": "subscription",
      "period": "rolling",
      "derivations": [],
      "description": "non-Gemini weekly remaining_fraction as used percent",
      "missingPolicy": "omit-optional"
    }
  ],
  "primaryPreference": [
    "antigravity-gemini"
  ],
  "diagnosticCodes": [],
  "reasonCodes": [],
  "fixtureIds": [
    "antigravity-synthetic-normal",
    "antigravity-synthetic-denied",
    "antigravity-synthetic-missing",
    "antigravity-synthetic-cli-groups"
  ],
  "provenance": [],
  "login": {
    "mode": "guide",
    "note": "启动 Antigravity app 或运行 agy 交互登录。2026-10-03 在已登录 agy 1.2.16 上验证 /usage。",
    "verified": true,
    "url": "https://antigravity.google",
    "launchMode": "web-guide"
  }
}
