{
  "schemaVersion": 1,
  "id": "grok",
  "name": "Grok",
  "product": "Grok Build subscription",
  "releaseStatus": "experimental",
  "adapterVersion": "0.1.0",
  "platforms": [
    "darwin"
  ],
  "docsPath": "docs/providers/grok.md",
  "documentationUrls": [
    "https://x.ai"
  ],
  "credentialReaders": [
    {
      "id": "grok-auth-file",
      "kind": "file",
      "credentialKinds": [
        "oauth"
      ],
      "implementationId": "grok-auth-file",
      "configurable": [
        "path"
      ],
      "requires": [],
      "purposes": [
        "primary"
      ],
      "owner": "external",
      "renewMode": "none"
    },
    {
      "id": "grok-subsbar-oauth",
      "kind": "keychain",
      "credentialKinds": [
        "oauth"
      ],
      "implementationId": "grok-subsbar-key",
      "configurable": [
        "service",
        "account",
        "keychainPath"
      ],
      "requires": [
        "keychain"
      ],
      "purposes": [
        "primary"
      ],
      "owner": "subsbar",
      "renewMode": "none",
      "credentialService": "SubsBar credential <providerId>"
    }
  ],
  "endpoints": [
    {
      "id": "grok-billing",
      "transport": "https",
      "operation": "usage",
      "readOnly": true,
      "grade": "C",
      "maxResponseBytes": 65536,
      "authPurpose": "primary",
      "documentationUrl": "https://x.ai",
      "method": "GET",
      "origin": "https://cli-chat-proxy.grok.com",
      "pathTemplate": "/v1/billing"
    }
  ],
  "dataSources": [
    {
      "id": "grok-proxy",
      "kind": "community-api",
      "grade": "C",
      "admission": "pending",
      "approvalNote": "docs/providers/grok.md；GET /v1/billing?format=credits。GROK_HOME 或 ~/.grok/auth.json。401/403 不轮换借用 token。网页 gRPC/WKE 不承诺。本轮未实测。",
      "endpointIds": [
        "grok-billing"
      ],
      "credentialChain": [
        "grok-auth-file",
        "grok-subsbar-oauth"
      ],
      "capabilities": [
        "quota",
        "balance"
      ],
      "coverageMetricRules": [
        "grok-weekly"
      ],
      "coverageMatch": "any"
    }
  ],
  "refresh": {
    "minimumIntervalSeconds": 60,
    "defaultIntervalSeconds": 300,
    "taskTimeoutSeconds": 30,
    "requestTimeoutSeconds": 15
  },
  "metricRules": [
    {
      "id": "grok-weekly",
      "metricId": "grok-weekly",
      "kind": "quota",
      "unit": "percent",
      "scope": "subscription",
      "period": "rolling",
      "derivations": [],
      "description": "shared weekly percent when period is ~7d; missing weekly is omitted not zero",
      "missingPolicy": "unknown"
    },
    {
      "id": "grok-monthly",
      "metricId": "grok-monthly",
      "kind": "quota",
      "unit": "percent",
      "scope": "subscription",
      "period": "calendar",
      "derivations": [],
      "description": "legacy monthly percent when period is ~30d; not labelled weekly",
      "missingPolicy": "omit-optional"
    },
    {
      "id": "grok-payg",
      "metricId": "payg-cap",
      "kind": "quota",
      "unit": "credits",
      "scope": "subscription",
      "period": "unknown",
      "derivations": [
        "remaining-from-limit-used"
      ],
      "description": "PAYG on-demand cap; separate from weekly",
      "missingPolicy": "omit-optional"
    }
  ],
  "primaryPreference": [
    "grok-weekly"
  ],
  "diagnosticCodes": [
    "pending-verification",
    "grok-payg-disabled"
  ],
  "reasonCodes": [],
  "fixtureIds": [
    "grok-synthetic-normal",
    "grok-synthetic-monthly",
    "grok-synthetic-missing"
  ],
  "provenance": [],
  "login": {
    "mode": "guide",
    "note": "grok login（UNVERIFIED as non-interactive this round）",
    "verified": false,
    "url": "https://x.ai",
    "launchMode": "web-guide"
  }
}
