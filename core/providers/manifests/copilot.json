{
  "schemaVersion": 1,
  "id": "copilot",
  "name": "GitHub Copilot",
  "product": "Copilot subscription",
  "releaseStatus": "experimental",
  "adapterVersion": "0.1.0",
  "platforms": [
    "darwin"
  ],
  "docsPath": "docs/providers/copilot.md",
  "documentationUrls": [
    "https://github.com/subsbar/subsbar#readme"
  ],
  "credentialReaders": [
    {
      "id": "copilot-official",
      "kind": "cli",
      "credentialKinds": [
        "cli-session"
      ],
      "implementationId": "copilot-official",
      "configurable": [
        "executablePath"
      ],
      "requires": [],
      "purposes": [
        "primary"
      ],
      "owner": "external",
      "renewMode": "owner-cli"
    },
    {
      "id": "copilot-editor-config",
      "kind": "file",
      "credentialKinds": [
        "oauth"
      ],
      "implementationId": "json-file-generic",
      "configurable": [
        "path"
      ],
      "requires": [],
      "purposes": [
        "primary"
      ],
      "owner": "external",
      "renewMode": "none"
    },
    {
      "id": "copilot-gh-keychain",
      "kind": "keychain",
      "credentialKinds": [
        "oauth"
      ],
      "implementationId": "keychain-generic",
      "configurable": [
        "service",
        "account"
      ],
      "requires": [
        "keychain"
      ],
      "purposes": [
        "primary"
      ],
      "owner": "external",
      "renewMode": "none"
    },
    {
      "id": "copilot-apps-json",
      "kind": "file",
      "credentialKinds": [
        "oauth"
      ],
      "implementationId": "copilot-apps-json",
      "configurable": [
        "path"
      ],
      "requires": [],
      "purposes": [
        "primary"
      ],
      "owner": "external",
      "renewMode": "none"
    },
    {
      "id": "github-copilot",
      "kind": "pi",
      "credentialKinds": [
        "oauth"
      ],
      "implementationId": "github-copilot",
      "configurable": [
        "path"
      ],
      "requires": [],
      "purposes": [
        "primary"
      ],
      "owner": "external",
      "renewMode": "none"
    }
  ],
  "endpoints": [
    {
      "id": "copilot-internal",
      "transport": "https",
      "operation": "usage",
      "readOnly": true,
      "grade": "C",
      "maxResponseBytes": 65536,
      "authPurpose": "primary",
      "documentationUrl": "https://github.com/subsbar/subsbar#readme",
      "method": "GET",
      "origin": "https://api.github.com",
      "pathTemplate": "/copilot_internal/user"
    },
    {
      "id": "copilot-cli-usage",
      "transport": "cli",
      "operation": "usage",
      "readOnly": true,
      "grade": "C",
      "maxResponseBytes": 65536,
      "authPurpose": "primary",
      "documentationUrl": "https://github.com/subsbar/subsbar#readme",
      "commandId": "copilot-usage"
    }
  ],
  "dataSources": [
    {
      "id": "copilot-official-cli",
      "kind": "official-cli",
      "grade": "A",
      "admission": "pending",
      "approvalNote": "docs/providers/copilot.md",
      "endpointIds": [
        "copilot-cli-usage"
      ],
      "credentialChain": [
        "copilot-official"
      ],
      "capabilities": [
        "quota"
      ],
      "coverageMetricRules": [
        "copilot-credits"
      ],
      "coverageMatch": "any"
    },
    {
      "id": "copilot-editor",
      "kind": "community-api",
      "grade": "C",
      "admission": "pending",
      "approvalNote": "docs/providers/copilot.md",
      "endpointIds": [
        "copilot-internal"
      ],
      "credentialChain": [
        "copilot-editor-config",
        "copilot-gh-keychain"
      ],
      "capabilities": [
        "quota"
      ],
      "coverageMetricRules": [
        "copilot-credits"
      ],
      "coverageMatch": "any"
    },
    {
      "id": "copilot-internal",
      "kind": "community-api",
      "grade": "C",
      "admission": "approved",
      "approvalNote": "docs/providers/copilot.md；copilot_internal/user 社区来源（C），个人配额；组织汇总需管理员另验",
      "endpointIds": [
        "copilot-internal"
      ],
      "credentialChain": [
        "copilot-apps-json",
        "copilot-gh-keychain",
        "github-copilot"
      ],
      "capabilities": [
        "quota"
      ],
      "coverageMetricRules": [
        "copilot-ai-credits",
        "copilot-premium-requests",
        "copilot-chat-requests"
      ],
      "coverageMatch": "any",
      "minimumIntervalSeconds": 300
    }
  ],
  "refresh": {
    "minimumIntervalSeconds": 60,
    "defaultIntervalSeconds": 300,
    "taskTimeoutSeconds": 30,
    "requestTimeoutSeconds": 15
  },
  "metricRules": [
    {
      "id": "copilot-credits",
      "metricId": "credits",
      "kind": "quota",
      "unit": "count",
      "scope": "subscription",
      "period": "calendar",
      "derivations": [],
      "description": "AI credits / legacy premium requests classification",
      "missingPolicy": "unknown"
    },
    {
      "id": "copilot-ai-credits",
      "metricId": "ai-credits",
      "kind": "quota",
      "unit": "count",
      "scope": "subscription",
      "period": "calendar",
      "derivations": [
        "used-from-limit-remaining",
        "remaining-from-limit-used",
        "limit-from-used-remaining"
      ],
      "description": "token-based billing AI credits",
      "missingPolicy": "unknown"
    },
    {
      "id": "copilot-premium-requests",
      "metricId": "premium-requests",
      "kind": "quota",
      "unit": "count",
      "scope": "subscription",
      "period": "calendar",
      "derivations": [
        "used-from-limit-remaining",
        "remaining-from-limit-used",
        "limit-from-used-remaining"
      ],
      "description": "legacy premium requests",
      "missingPolicy": "unknown"
    },
    {
      "id": "copilot-chat-requests",
      "metricId": "chat-requests",
      "kind": "quota",
      "unit": "count",
      "scope": "subscription",
      "period": "calendar",
      "derivations": [
        "used-from-limit-remaining",
        "remaining-from-limit-used",
        "limit-from-used-remaining"
      ],
      "description": "limited_user_quotas chat legacy shape",
      "missingPolicy": "unknown"
    }
  ],
  "primaryPreference": [
    "copilot-credits"
  ],
  "diagnosticCodes": [
    "copilot-plan"
  ],
  "reasonCodes": [],
  "fixtureIds": [
    "copilot-synthetic-normal",
    "copilot-synthetic-missing"
  ],
  "provenance": [],
  "login": {
    "mode": "command",
    "note": "Authenticate with a GitHub host（--help 核实；无 token 环境打印 device URL）",
    "verified": true,
    "command": "gh",
    "args": [
      "auth",
      "login"
    ],
    "launchMode": "headless-url",
    "urlPattern": "^https://github\\.com/login/device"
  }
}
