{
  "schemaVersion": 1,
  "id": "claude",
  "name": "Claude",
  "product": "Claude Pro/Max subscription",
  "releaseStatus": "blocked",
  "adapterVersion": "0.1.0",
  "platforms": [
    "darwin"
  ],
  "docsPath": "docs/providers/claude.md",
  "documentationUrls": [
    "https://github.com/subsbar/subsbar#readme"
  ],
  "credentialReaders": [
    {
      "id": "claude-official-usage",
      "kind": "cli",
      "credentialKinds": [
        "cli-session"
      ],
      "implementationId": "claude-official-usage",
      "configurable": [
        "executablePath"
      ],
      "requires": [],
      "purposes": [
        "primary"
      ],
      "owner": "external",
      "renewMode": "owner-cli"
    },
    {
      "id": "claude-pi-anthropic",
      "kind": "pi",
      "credentialKinds": [
        "oauth"
      ],
      "implementationId": "claude-pi-anthropic",
      "configurable": [
        "path"
      ],
      "requires": [],
      "purposes": [
        "primary"
      ],
      "owner": "external",
      "renewMode": "none"
    }
  ],
  "endpoints": [
    {
      "id": "claude-usage-cli",
      "transport": "cli",
      "operation": "usage",
      "readOnly": true,
      "grade": "C",
      "maxResponseBytes": 65536,
      "authPurpose": "primary",
      "documentationUrl": "https://github.com/subsbar/subsbar#readme",
      "commandId": "claude-usage"
    },
    {
      "id": "claude-usage-http",
      "transport": "https",
      "operation": "usage",
      "readOnly": true,
      "grade": "C",
      "origin": "https://api.anthropic.com",
      "method": "GET",
      "pathTemplate": "/api/oauth/usage",
      "maxResponseBytes": 65536,
      "authPurpose": "primary",
      "documentationUrl": "https://subsbar.dev/docs"
    }
  ],
  "dataSources": [
    {
      "id": "claude-cli-usage",
      "kind": "official-cli",
      "grade": "B",
      "admission": "blocked",
      "approvalNote": "docs/providers/claude.md；Claude 必做目标。离线解析已就绪。实时准入 blocked，等待适用许可/官方机器协议。blocked 需新证据，不能当 pending 直接启用。",
      "endpointIds": [
        "claude-usage-cli"
      ],
      "credentialChain": [
        "claude-official-usage"
      ],
      "capabilities": [
        "quota"
      ],
      "coverageMetricRules": [
        "claude-session"
      ],
      "coverageMatch": "any"
    },
    {
      "id": "claude-oauth-usage",
      "kind": "community-api",
      "grade": "C",
      "admission": "blocked",
      "approvalNote": "docs/providers/claude.md；离线解析已就绪。实时准入 blocked（等适用许可）。不实现 secret reader、不消费 refresh、refresh 拒绝执行。",
      "endpointIds": [
        "claude-usage-http"
      ],
      "credentialChain": [
        "claude-pi-anthropic"
      ],
      "capabilities": [
        "quota"
      ],
      "coverageMetricRules": [
        "claude-five-hour",
        "claude-seven-day",
        "claude-seven-day-opus",
        "claude-seven-day-sonnet",
        "claude-extra-usage"
      ],
      "coverageMatch": "any",
      "minimumIntervalSeconds": 300
    }
  ],
  "refresh": {
    "minimumIntervalSeconds": 60,
    "defaultIntervalSeconds": 300,
    "taskTimeoutSeconds": 30,
    "requestTimeoutSeconds": 15
  },
  "metricRules": [
    {
      "id": "claude-session",
      "metricId": "session",
      "kind": "quota",
      "unit": "percent",
      "scope": "subscription",
      "period": "rolling",
      "derivations": [],
      "description": "session/weekly windows; pending C23 admission",
      "missingPolicy": "unknown"
    },
    {
      "id": "claude-five-hour",
      "metricId": "five-hour",
      "kind": "quota",
      "unit": "percent",
      "scope": "subscription",
      "period": "rolling",
      "derivations": [],
      "description": "five_hour utilization percent (raw, no clamp)",
      "missingPolicy": "unknown"
    },
    {
      "id": "claude-seven-day",
      "metricId": "seven-day",
      "kind": "quota",
      "unit": "percent",
      "scope": "subscription",
      "period": "rolling",
      "derivations": [],
      "description": "seven_day utilization percent",
      "missingPolicy": "unknown"
    },
    {
      "id": "claude-seven-day-opus",
      "metricId": "seven-day-opus",
      "kind": "quota",
      "unit": "percent",
      "scope": "subscription",
      "period": "rolling",
      "derivations": [],
      "description": "seven_day_opus utilization percent",
      "missingPolicy": "unknown"
    },
    {
      "id": "claude-seven-day-sonnet",
      "metricId": "seven-day-sonnet",
      "kind": "quota",
      "unit": "percent",
      "scope": "subscription",
      "period": "rolling",
      "derivations": [],
      "description": "seven_day_sonnet utilization percent (raw, no clamp)",
      "missingPolicy": "unknown"
    },
    {
      "id": "claude-extra-usage",
      "metricId": "extra-usage",
      "kind": "quota",
      "unit": "currency",
      "currencyFromPayload": true,
      "scope": "subscription",
      "period": "calendar",
      "derivations": [
        "remaining-from-limit-used"
      ],
      "description": "extra_usage amount+currency; never mixed into percent windows",
      "missingPolicy": "unknown"
    },
    {
      "id": "claude-weekly-scoped",
      "metricId": "weekly-scoped",
      "kind": "quota",
      "unit": "percent",
      "scope": "subscription",
      "period": "rolling",
      "derivations": [],
      "description": "limits[] kind=weekly_scoped percent by scope.model.display_name",
      "missingPolicy": "unknown"
    }
  ],
  "primaryPreference": [
    "claude-five-hour"
  ],
  "diagnosticCodes": [],
  "reasonCodes": [],
  "fixtureIds": [
    "claude-synthetic-normal",
    "claude-synthetic-missing",
    "claude-synthetic-null-windows",
    "claude-synthetic-not-started",
    "claude-synthetic-scoped",
    "claude-synthetic-extra",
    "claude-oauth-shape"
  ],
  "provenance": [],
  "login": {
    "mode": "command",
    "note": "Sign in to your Anthropic account（--help 核实）",
    "verified": true,
    "command": "claude",
    "args": [
      "auth",
      "login"
    ],
    "launchMode": "headless-url",
    "urlPattern": "^https://claude\\.com/cai/oauth/authorize"
  }
}
