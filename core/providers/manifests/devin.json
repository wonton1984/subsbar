{
  "schemaVersion": 1,
  "id": "devin",
  "name": "Devin",
  "product": "Devin subscription",
  "releaseStatus": "experimental",
  "adapterVersion": "0.1.0",
  "platforms": [
    "darwin"
  ],
  "docsPath": "docs/providers/devin.md",
  "documentationUrls": [
    "https://app.devin.ai"
  ],
  "credentialReaders": [
    {
      "id": "devin-credentials-toml",
      "kind": "file",
      "credentialKinds": [
        "api-key"
      ],
      "implementationId": "devin-toml",
      "configurable": [
        "path"
      ],
      "requires": [],
      "purposes": [
        "primary"
      ],
      "owner": "external",
      "renewMode": "none"
    },
    {
      "id": "devin-app-db",
      "kind": "file",
      "credentialKinds": [
        "api-key"
      ],
      "implementationId": "devin-app-db",
      "configurable": [
        "path"
      ],
      "requires": [],
      "purposes": [
        "primary"
      ],
      "owner": "external",
      "renewMode": "none"
    },
    {
      "id": "devin-web-session",
      "kind": "keychain",
      "credentialKinds": [
        "cookie"
      ],
      "implementationId": "devin-subsbar-session",
      "configurable": [
        "service",
        "account",
        "keychainPath"
      ],
      "requires": [
        "keychain"
      ],
      "purposes": [
        "primary"
      ],
      "owner": "subsbar",
      "renewMode": "none",
      "credentialService": "SubsBar credential <providerId>"
    },
    {
      "id": "devin-browser-localstorage",
      "kind": "browser",
      "credentialKinds": [
        "cookie"
      ],
      "implementationId": "browser-generic",
      "configurable": [
        "browserProfile",
        "origin"
      ],
      "requires": [
        "browser"
      ],
      "purposes": [
        "primary"
      ],
      "owner": "external",
      "renewMode": "none"
    }
  ],
  "endpoints": [
    {
      "id": "devin-org-quota",
      "transport": "https",
      "operation": "usage",
      "readOnly": true,
      "grade": "C",
      "maxResponseBytes": 65536,
      "authPurpose": "primary",
      "documentationUrl": "https://app.devin.ai",
      "method": "GET",
      "origin": "https://app.devin.ai",
      "pathTemplate": "/api/{organizationId}/billing/quota/usage"
    }
  ],
  "dataSources": [
    {
      "id": "devin-cli-app",
      "kind": "community-api",
      "grade": "C",
      "admission": "pending",
      "approvalNote": "docs/providers/devin.md；TOML windsurf_api_key 已实现。GetUserStatus Connect 帧本轮未验证，不登记未证实的 RPC path；live fetch=not-implemented。禁止跨账户 fallback。app DB not-implemented。",
      "endpointIds": [],
      "credentialChain": [
        "devin-credentials-toml",
        "devin-app-db"
      ],
      "capabilities": [
        "quota"
      ],
      "coverageMetricRules": [
        "devin-daily"
      ],
      "coverageMatch": "any"
    },
    {
      "id": "devin-web-org",
      "kind": "community-api",
      "grade": "C",
      "admission": "pending",
      "approvalNote": "docs/providers/devin.md；网页 org quota 需手动 Keychain 会话 + organizationId。自动 localStorage 仅显式 allowBrowser，本轮 not-implemented。daily 不贴 weekly。",
      "endpointIds": [
        "devin-org-quota"
      ],
      "credentialChain": [
        "devin-web-session"
      ],
      "capabilities": [
        "quota",
        "balance"
      ],
      "coverageMetricRules": [
        "devin-daily",
        "devin-weekly"
      ],
      "coverageMatch": "any",
      "organizationScoped": true
    }
  ],
  "refresh": {
    "minimumIntervalSeconds": 60,
    "defaultIntervalSeconds": 300,
    "taskTimeoutSeconds": 30,
    "requestTimeoutSeconds": 15
  },
  "metricRules": [
    {
      "id": "devin-daily",
      "metricId": "devin-daily",
      "kind": "quota",
      "unit": "percent",
      "scope": "subscription",
      "period": "rolling",
      "derivations": [],
      "description": "daily quota percent used; omitted when hide_daily_quota",
      "missingPolicy": "omit-optional"
    },
    {
      "id": "devin-weekly",
      "metricId": "devin-weekly",
      "kind": "quota",
      "unit": "percent",
      "scope": "subscription",
      "period": "rolling",
      "derivations": [],
      "description": "weekly quota percent used; never copied from daily",
      "missingPolicy": "unknown"
    },
    {
      "id": "devin-extra-balance",
      "metricId": "extra-balance",
      "kind": "balance",
      "unit": "currency",
      "currency": "USD",
      "scope": "organization",
      "period": "unknown",
      "derivations": [],
      "description": "extra/overage balance USD when present",
      "missingPolicy": "omit-optional"
    }
  ],
  "primaryPreference": [
    "devin-daily"
  ],
  "diagnosticCodes": [
    "pending-verification"
  ],
  "reasonCodes": [],
  "fixtureIds": [
    "devin-synthetic-normal",
    "devin-synthetic-hide-daily",
    "devin-synthetic-missing"
  ],
  "provenance": [],
  "login": {
    "mode": "guide",
    "note": "CLI `devin auth login` 或网页 app.devin.ai；会话导入见 docs/providers/devin.md（UNVERIFIED）",
    "verified": false,
    "url": "https://app.devin.ai",
    "launchMode": "web-guide"
  }
}
