{
  "schemaVersion": 1,
  "id": "devin",
  "name": "Devin",
  "product": "Devin subscription",
  "releaseStatus": "supported",
  "adapterVersion": "0.2.0",
  "platforms": [
    "darwin"
  ],
  "docsPath": "docs/providers/devin.md",
  "documentationUrls": [
    "https://app.devin.ai"
  ],
  "credentialReaders": [
    {
      "id": "devin-credentials-toml",
      "kind": "file",
      "credentialKinds": [
        "api-key"
      ],
      "implementationId": "devin-toml",
      "configurable": [
        "path"
      ],
      "requires": [],
      "purposes": [
        "primary"
      ],
      "owner": "external",
      "renewMode": "none"
    },
    {
      "id": "devin-app-db",
      "kind": "file",
      "credentialKinds": [
        "api-key"
      ],
      "implementationId": "devin-app-db",
      "configurable": [
        "path"
      ],
      "requires": [],
      "purposes": [
        "primary"
      ],
      "owner": "external",
      "renewMode": "none"
    },
    {
      "id": "devin-web-session",
      "kind": "keychain",
      "credentialKinds": [
        "cookie"
      ],
      "implementationId": "devin-subsbar-session",
      "configurable": [
        "service",
        "account",
        "keychainPath"
      ],
      "requires": [
        "keychain"
      ],
      "purposes": [
        "primary"
      ],
      "owner": "subsbar",
      "renewMode": "none",
      "credentialService": "SubsBar credential <providerId>"
    },
    {
      "id": "devin-browser-localstorage",
      "kind": "browser",
      "credentialKinds": [
        "cookie"
      ],
      "implementationId": "browser-generic",
      "configurable": [
        "browserProfile",
        "origin"
      ],
      "requires": [
        "browser"
      ],
      "purposes": [
        "primary"
      ],
      "owner": "external",
      "renewMode": "none"
    }
  ],
  "endpoints": [
    {
      "id": "devin-organizations",
      "transport": "https",
      "operation": "identity",
      "readOnly": true,
      "grade": "C",
      "maxResponseBytes": 65536,
      "authPurpose": "primary",
      "documentationUrl": "https://app.devin.ai",
      "method": "GET",
      "origin": "https://app.devin.ai",
      "pathTemplate": "/api/organizations"
    },
    {
      "id": "devin-org-quota",
      "transport": "https",
      "operation": "usage",
      "readOnly": true,
      "grade": "C",
      "maxResponseBytes": 65536,
      "authPurpose": "primary",
      "documentationUrl": "https://app.devin.ai",
      "method": "GET",
      "origin": "https://app.devin.ai",
      "pathTemplate": "/api/{organizationId}/billing/quota/usage"
    }
  ],
  "dataSources": [
    {
      "id": "devin-cli-app",
      "kind": "community-api",
      "grade": "C",
      "admission": "pending",
      "approvalNote": "docs/providers/devin.md；TOML windsurf_api_key 已实现。GetUserStatus Connect 帧本轮未验证，不登记未证实的 RPC path；live fetch=not-implemented。禁止跨账户 fallback。app DB not-implemented。",
      "endpointIds": [],
      "credentialChain": [
        "devin-credentials-toml",
        "devin-app-db"
      ],
      "capabilities": [
        "quota"
      ],
      "coverageMetricRules": [
        "devin-daily"
      ],
      "coverageMatch": "any"
    },
    {
      "id": "devin-web-org",
      "kind": "community-api",
      "grade": "C",
      "admission": "approved",
      "approvalNote": "2026-10-27 本机实测：CLI TOML windsurf_api_key 作为 Bearer；GET /api/organizations 裸数组 org_id；GET /api/{org_id}/billing/quota/usage + x-cog-org-id 返回 flat daily/weekly_percentage 与 reset_at。无组织配置时自动发现；多组织无唯一主组织时显式诊断。禁止失败后跨账号/组织回退。",
      "endpointIds": [
        "devin-organizations",
        "devin-org-quota"
      ],
      "credentialChain": [
        "devin-credentials-toml"
      ],
      "capabilities": [
        "quota",
        "balance"
      ],
      "coverageMetricRules": [
        "devin-daily",
        "devin-weekly"
      ],
      "coverageMatch": "any",
      "organizationScoped": true
    }
  ],
  "refresh": {
    "minimumIntervalSeconds": 60,
    "defaultIntervalSeconds": 300,
    "taskTimeoutSeconds": 30,
    "requestTimeoutSeconds": 15
  },
  "metricRules": [
    {
      "id": "devin-daily",
      "metricId": "devin-daily",
      "kind": "quota",
      "unit": "percent",
      "scope": "subscription",
      "period": "rolling",
      "derivations": [],
      "description": "daily quota percent used; omitted when hide_daily_quota",
      "missingPolicy": "omit-optional"
    },
    {
      "id": "devin-weekly",
      "metricId": "devin-weekly",
      "kind": "quota",
      "unit": "percent",
      "scope": "subscription",
      "period": "rolling",
      "derivations": [],
      "description": "weekly quota percent used; never copied from daily",
      "missingPolicy": "unknown"
    },
    {
      "id": "devin-extra-balance",
      "metricId": "extra-balance",
      "kind": "balance",
      "unit": "currency",
      "currency": "USD",
      "scope": "organization",
      "period": "unknown",
      "derivations": [],
      "description": "extra/overage balance USD when present",
      "missingPolicy": "omit-optional"
    }
  ],
  "primaryPreference": [
    "devin-daily"
  ],
  "diagnosticCodes": [
    "pending-verification",
    "org-selection-ambiguous",
    "overage-available"
  ],
  "reasonCodes": [],
  "fixtureIds": [
    "devin-synthetic-normal",
    "devin-synthetic-hide-daily",
    "devin-synthetic-missing",
    "devin-synthetic-flat"
  ],
  "provenance": [],
  "login": {
    "mode": "guide",
    "note": "先在 Devin CLI 登录；自动读取 CLI 凭证并查询组织日/周额度。CLI GetUserStatus 来源仍待验证。",
    "verified": false,
    "url": "https://app.devin.ai",
    "launchMode": "web-guide"
  }
}
