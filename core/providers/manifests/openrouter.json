{
  "schemaVersion": 1,
  "id": "openrouter",
  "name": "OpenRouter",
  "product": "OpenRouter key quota",
  "releaseStatus": "experimental",
  "adapterVersion": "0.1.0",
  "platforms": [
    "darwin"
  ],
  "docsPath": "docs/providers/openrouter.md",
  "documentationUrls": [
    "https://openrouter.ai/docs/api/api-reference/api-keys/get-current-key",
    "https://openrouter.ai/docs/api/api-reference/credits/get-credits",
    "https://openrouter.ai/terms"
  ],
  "credentialReaders": [
    {
      "id": "openrouter-env-key",
      "kind": "env",
      "credentialKinds": [
        "api-key"
      ],
      "implementationId": "env-generic",
      "configurable": [
        "envName"
      ],
      "requires": [],
      "purposes": [
        "primary"
      ],
      "owner": "external",
      "renewMode": "none"
    },
    {
      "id": "openrouter-subsbar-key",
      "kind": "keychain",
      "credentialKinds": [
        "api-key"
      ],
      "implementationId": "openrouter-subsbar-key",
      "configurable": [
        "service",
        "account",
        "keychainPath"
      ],
      "requires": [
        "keychain"
      ],
      "purposes": [
        "primary"
      ],
      "owner": "subsbar",
      "renewMode": "none",
      "credentialService": "SubsBar credential <providerId>"
    },
    {
      "id": "openrouter",
      "kind": "pi",
      "credentialKinds": [
        "api-key"
      ],
      "implementationId": "openrouter",
      "configurable": [
        "path"
      ],
      "requires": [],
      "purposes": [
        "primary"
      ],
      "owner": "external",
      "renewMode": "none"
    },
    {
      "id": "openrouter-management",
      "kind": "keychain",
      "credentialKinds": [
        "api-key"
      ],
      "implementationId": "openrouter-management-key",
      "configurable": [
        "service",
        "account",
        "keychainPath"
      ],
      "requires": [
        "keychain"
      ],
      "purposes": [
        "management"
      ],
      "owner": "subsbar",
      "renewMode": "none",
      "credentialService": "SubsBar credential <providerId>"
    }
  ],
  "endpoints": [
    {
      "id": "openrouter-key",
      "transport": "https",
      "operation": "usage",
      "readOnly": true,
      "grade": "A",
      "maxResponseBytes": 65536,
      "authPurpose": "primary",
      "documentationUrl": "https://openrouter.ai/docs/api/api-reference/api-keys/get-current-key",
      "method": "GET",
      "origin": "https://openrouter.ai",
      "pathTemplate": "/api/v1/key"
    },
    {
      "id": "openrouter-credits",
      "transport": "https",
      "operation": "usage",
      "readOnly": true,
      "grade": "A",
      "maxResponseBytes": 65536,
      "authPurpose": "management",
      "documentationUrl": "https://openrouter.ai/docs/api/api-reference/credits/get-credits",
      "method": "GET",
      "origin": "https://openrouter.ai",
      "pathTemplate": "/api/v1/credits"
    }
  ],
  "dataSources": [
    {
      "id": "openrouter-key",
      "kind": "official-api",
      "grade": "A",
      "admission": "approved",
      "approvalNote": "docs/providers/openrouter.md；普通 key GET /api/v1/key（A）。/credits 需 management key，本轮调度不解析第二凭证；403 时保留 key quota，余额 unavailable。limit_remaining 不是账户余额。本轮未实测真实端点。",
      "endpointIds": [
        "openrouter-key"
      ],
      "credentialChain": [
        "openrouter-env-key",
        "openrouter-subsbar-key",
        "openrouter"
      ],
      "capabilities": [
        "quota"
      ],
      "coverageMetricRules": [
        "openrouter-limit"
      ],
      "coverageMatch": "any"
    },
    {
      "id": "openrouter-credits",
      "kind": "official-api",
      "grade": "A",
      "admission": "pending",
      "approvalNote": "docs/providers/openrouter.md；GET /api/v1/credits 官方标注 management key required。本轮未接入双凭证 resolve，refresh 不自动跑此源。",
      "endpointIds": [
        "openrouter-credits"
      ],
      "credentialChain": [
        "openrouter-management"
      ],
      "capabilities": [
        "balance"
      ],
      "coverageMetricRules": [],
      "coverageMatch": "any"
    }
  ],
  "refresh": {
    "minimumIntervalSeconds": 60,
    "defaultIntervalSeconds": 300,
    "taskTimeoutSeconds": 30,
    "requestTimeoutSeconds": 15
  },
  "metricRules": [
    {
      "id": "openrouter-limit",
      "metricId": "limit",
      "kind": "quota",
      "unit": "currency",
      "scope": "subscription",
      "period": "unknown",
      "derivations": [
        "remaining-from-limit-used"
      ],
      "description": "key quota; account credits are separate management purpose",
      "missingPolicy": "unknown",
      "currency": "USD"
    },
    {
      "id": "openrouter-usage-daily",
      "metricId": "usage-daily",
      "kind": "spend",
      "unit": "currency",
      "scope": "api-key",
      "period": "unknown",
      "derivations": [],
      "currency": "USD",
      "description": "daily spend USD",
      "missingPolicy": "omit-optional"
    },
    {
      "id": "openrouter-usage-weekly",
      "metricId": "usage-weekly",
      "kind": "spend",
      "unit": "currency",
      "scope": "api-key",
      "period": "unknown",
      "derivations": [],
      "currency": "USD",
      "description": "weekly spend USD",
      "missingPolicy": "omit-optional"
    },
    {
      "id": "openrouter-usage-monthly",
      "metricId": "usage-monthly",
      "kind": "spend",
      "unit": "currency",
      "scope": "api-key",
      "period": "unknown",
      "derivations": [],
      "currency": "USD",
      "description": "monthly spend USD",
      "missingPolicy": "omit-optional"
    },
    {
      "id": "openrouter-usage-total",
      "metricId": "usage-total",
      "kind": "spend",
      "unit": "currency",
      "scope": "api-key",
      "period": "lifetime",
      "derivations": [],
      "currency": "USD",
      "description": "total spend USD",
      "missingPolicy": "omit-optional"
    }
  ],
  "primaryPreference": [
    "openrouter-limit"
  ],
  "diagnosticCodes": [
    "openrouter-no-limit",
    "openrouter-free-tier",
    "openrouter-credits-unavailable"
  ],
  "reasonCodes": [],
  "fixtureIds": [
    "openrouter-synthetic-normal",
    "openrouter-synthetic-no-limit",
    "openrouter-synthetic-credits"
  ],
  "provenance": [],
  "login": {
    "mode": "guide",
    "note": "openrouter.ai Keys 页创建 key",
    "verified": false,
    "url": "https://openrouter.ai/keys",
    "launchMode": "web-guide"
  }
}
