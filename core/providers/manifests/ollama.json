{
  "schemaVersion": 1,
  "id": "ollama",
  "name": "Ollama Cloud",
  "product": "Ollama Cloud subscription",
  "releaseStatus": "experimental",
  "adapterVersion": "0.1.0",
  "platforms": [
    "darwin"
  ],
  "docsPath": "docs/providers/ollama.md",
  "documentationUrls": [
    "https://github.com/subsbar/subsbar#readme"
  ],
  "credentialReaders": [
    {
      "id": "ollama-signing-key",
      "kind": "file",
      "credentialKinds": [
        "request-signer"
      ],
      "implementationId": "ollama-signing-key",
      "configurable": [
        "path"
      ],
      "requires": [],
      "purposes": [
        "primary"
      ],
      "owner": "external",
      "renewMode": "none"
    }
  ],
  "endpoints": [
    {
      "id": "ollama-usage",
      "transport": "https",
      "operation": "usage",
      "readOnly": true,
      "grade": "C",
      "maxResponseBytes": 65536,
      "authPurpose": "primary",
      "documentationUrl": "https://github.com/subsbar/subsbar#readme",
      "method": "GET",
      "origin": "https://ollama.com",
      "pathTemplate": "/api/usage"
    }
  ],
  "dataSources": [
    {
      "id": "ollama-signed",
      "kind": "official-api",
      "grade": "C",
      "admission": "pending",
      "approvalNote": "pending-verification: 防御性解析已实现，响应字段名未经真实账号验证（本机网络无法核实开源实现细节）；真实账号冒烟前排程",
      "endpointIds": [
        "ollama-usage"
      ],
      "credentialChain": [
        "ollama-signing-key"
      ],
      "capabilities": [
        "quota"
      ],
      "coverageMetricRules": [
        "ollama-monthly"
      ],
      "coverageMatch": "any"
    }
  ],
  "refresh": {
    "minimumIntervalSeconds": 60,
    "defaultIntervalSeconds": 300,
    "taskTimeoutSeconds": 30,
    "requestTimeoutSeconds": 15
  },
  "metricRules": [
    {
      "id": "ollama-monthly",
      "metricId": "monthly",
      "kind": "quota",
      "unit": "count",
      "scope": "subscription",
      "period": "calendar",
      "derivations": [],
      "description": "monthly or session/weekly by new billing; never guess reset",
      "missingPolicy": "unknown"
    }
  ],
  "primaryPreference": [
    "ollama-monthly"
  ],
  "diagnosticCodes": [
    "pending-verification"
  ],
  "reasonCodes": [],
  "fixtureIds": [
    "ollama-synthetic-normal",
    "ollama-synthetic-missing"
  ],
  "provenance": [],
  "login": {
    "mode": "command",
    "note": "Sign in to ollama.com（--help 核实）",
    "verified": true,
    "command": "ollama",
    "args": [
      "signin"
    ]
  }
}
