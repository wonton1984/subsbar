{
  "schemaVersion": 1,
  "id": "ollama",
  "name": "Ollama Cloud",
  "product": "Ollama Cloud subscription",
  "releaseStatus": "experimental",
  "adapterVersion": "0.1.0",
  "platforms": [
    "darwin"
  ],
  "docsPath": "docs/providers/ollama.md",
  "documentationUrls": [
    "https://github.com/subsbar/subsbar#readme"
  ],
  "credentialReaders": [
    {
      "id": "ollama-signing-key",
      "kind": "file",
      "credentialKinds": [
        "request-signer"
      ],
      "implementationId": "ollama-signing-key",
      "configurable": [
        "path"
      ],
      "requires": [],
      "purposes": [
        "primary"
      ],
      "owner": "external",
      "renewMode": "none"
    }
  ],
  "endpoints": [
    {
      "id": "ollama-usage",
      "transport": "https",
      "operation": "usage",
      "readOnly": true,
      "grade": "C",
      "maxResponseBytes": 65536,
      "authPurpose": "primary",
      "documentationUrl": "https://github.com/subsbar/subsbar#readme",
      "method": "GET",
      "origin": "https://ollama.com",
      "pathTemplate": "/api/usage"
    }
  ],
  "dataSources": [
    {
      "id": "ollama-signed",
      "kind": "official-api",
      "grade": "C",
      "admission": "pending",
      "approvalNote": "pending-verification: 签名主路径已实现（OpenSSH Ed25519 → GET /api/usage）；响应字段名与新旧计费形态未经真实账号验证。普通 OLLAMA_API_KEY 不替代 quota。refresh 拒绝执行。",
      "endpointIds": [
        "ollama-usage"
      ],
      "credentialChain": [
        "ollama-signing-key"
      ],
      "capabilities": [
        "quota"
      ],
      "coverageMetricRules": [
        "ollama-monthly",
        "ollama-session",
        "ollama-weekly"
      ],
      "coverageMatch": "any"
    }
  ],
  "refresh": {
    "minimumIntervalSeconds": 60,
    "defaultIntervalSeconds": 300,
    "taskTimeoutSeconds": 30,
    "requestTimeoutSeconds": 15
  },
  "metricRules": [
    {
      "id": "ollama-monthly",
      "metricId": "monthly",
      "kind": "quota",
      "unit": "count",
      "scope": "subscription",
      "period": "calendar",
      "derivations": [],
      "description": "new-plan monthly credits when present; never guess reset",
      "missingPolicy": "unknown"
    },
    {
      "id": "ollama-session",
      "metricId": "session",
      "kind": "quota",
      "unit": "percent",
      "scope": "subscription",
      "period": "rolling",
      "derivations": [],
      "description": "legacy 5h session window when present; reset unknown unless upstream sends it",
      "missingPolicy": "unknown"
    },
    {
      "id": "ollama-weekly",
      "metricId": "weekly",
      "kind": "quota",
      "unit": "percent",
      "scope": "subscription",
      "period": "rolling",
      "derivations": [],
      "description": "legacy 7d weekly window when present; reset unknown unless upstream sends it",
      "missingPolicy": "unknown"
    }
  ],
  "primaryPreference": [
    "ollama-monthly",
    "ollama-session",
    "ollama-weekly"
  ],
  "diagnosticCodes": [
    "pending-verification"
  ],
  "reasonCodes": [],
  "fixtureIds": [
    "ollama-synthetic-normal",
    "ollama-synthetic-legacy",
    "ollama-synthetic-missing"
  ],
  "provenance": [],
  "login": {
    "mode": "command",
    "note": "Sign in to ollama.com（--help 核实；需本机 daemon）",
    "verified": true,
    "command": "ollama",
    "args": [
      "signin"
    ],
    "launchMode": "headless-url",
    "url": "https://ollama.com"
  }
}
